# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# Contraseña del Admin Supremo (Por defecto: 09009001009)
ADMIN_PASSWORD=09009001009

# Secreto para firmar sesiones (Opcional)
SESSION_SECRET=monitor_usdt_secret_production_key

# API Keys del Admin Supremo (Opcional, también configurables desde el panel web)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Ruta del archivo de datos (Opcional, útil si agregas un Persistent Disk en Render como /var/data/data.json)
DATA_FILE=

